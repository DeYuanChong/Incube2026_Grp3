# --- AI (OpenAI-compatible vLLM endpoint) ---
VLLM_BASE_URL=http://localhost:8080/v1
VLLM_API_KEY=not-needed
VLLM_TEXT_MODEL=Qwen/Qwen2.5-14B-Instruct
VLLM_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
AI_TIMEOUT_SECONDS=30

# --- Service URLs (defaults work for local + docker-compose overrides them) ---
GATEWAY_URL=http://localhost:8000
REPORTING_URL=http://localhost:8001
TRIAGE_URL=http://localhost:8002
FIXVERIFY_URL=http://localhost:8003
NOTIFICATION_URL=http://localhost:8004

# --- Tuning ---
SYSTEMIC_MIN_COUNT=3
SYSTEMIC_WINDOW_DAYS=90
CAPACITY_PER_DAY=10
