# --- AI (OpenAI-compatible endpoint) ---
VLLM_BASE_URL=https://zenmux.ai/api/v1
VLLM_API_KEY=sk-your-zenmux-api-key-here
VLLM_TEXT_MODEL=google/gemini-2.5-flash-lite
VLLM_VISION_MODEL=google/gemini-2.5-flash-lite
AI_TIMEOUT_SECONDS=60

# --- Service URLs (defaults work for local + docker-compose overrides them) ---
GATEWAY_URL=http://localhost:8000
REPORTING_URL=http://localhost:8001
TRIAGE_URL=http://localhost:8002
FIXVERIFY_URL=http://localhost:8003
NOTIFICATION_URL=http://localhost:8004

# --- Database ---
# One shared PostgreSQL database; each service owns its own schema
# (reporting, triage, fixverify, notification). docker-compose sets this
# automatically; for local non-docker runs the default below matches the
# compose postgres container exposed on localhost:5432.
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/defects

# --- Tuning ---
SYSTEMIC_MIN_COUNT=3
SYSTEMIC_WINDOW_DAYS=90
CAPACITY_PER_DAY=10
